{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "outDir": "out/web",
    "rootDir": "src",
    "types": ["node"]
  },
  "include": ["src/main/server.ts"]
}
