# Modo web headless tailnet — spec v1.2 (0.0.0.0:8888).
# El server web real vive en out/web/main/server.js (`npm run start:web`); el
# HEALTHCHECK pega a /healthz (sin token) y la SPA/WS exigen Bearer (WEB_TOKEN).

# ── builder: toolchain C++ para node-pty / better-sqlite3 ────────────────────
FROM node:22-bookworm AS builder
RUN apt-get update \
  && apt-get install -y --no-install-recommends python3 make g++ \
  && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY package.json package-lock.json ./
# --ignore-scripts: el postinstall (electron-rebuild -f) compila contra el ABI
# de Electron y exige headers de Electron; para empaquetar el bundle web no
# hace falta (electron-vite es bundling puro). Los nativos se recompilan
# contra Node 22 en el stage runtime.
RUN npm ci --ignore-scripts
COPY . .
# Usa build:web si el slice backend lo define; si no, build Electron (proxy).
RUN sh -c 'if npm run 2>/dev/null | grep -q " build:web"; then npm run build:web; else npm run build; fi'

# ── runtime: plain Node (NO Electron) en 0.0.0.0:8888 ─────────────────────────
FROM node:22-bookworm-slim
RUN apt-get update \
  && apt-get install -y --no-install-recommends python3 make g++ \
  && rm -rf /var/lib/apt/lists/*
ENV NODE_ENV=production \
  WEB_HOST=0.0.0.0 \
  WEB_PORT=8888 \
  HARNESS_HOME=/data
WORKDIR /app
COPY package.json package-lock.json ./
# --ignore-scripts evita el postinstall de Electron (electron-rebuild -f deja
# binarios con ABI de Electron, inservibles bajo Node plano → ERR-W07). Luego
# se recompila contra el ABI de Node 22 de esta imagen.
RUN npm ci --omit=dev --ignore-scripts \
  && npm rebuild better-sqlite3 node-pty
COPY --from=builder /app/out ./out
RUN mkdir -p /data && chown node:node /data
VOLUME /data
USER node
EXPOSE 8888
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:'+(process.env.WEB_PORT||8888)+'/agentes').then(r=>{if(!r.ok)process.exit(1)}).catch(()=>process.exit(1))"
# Server web headless: WS /cth/v1 + estático + /healthz en WEB_PORT.
CMD ["sh", "-c", "npm run start:web"]
